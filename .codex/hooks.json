{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/session-start.sh')\"",
            "timeout": 10,
            "statusMessage": "Loading project session context"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/detect-gaps.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/detect-gaps.sh')\"",
            "timeout": 10,
            "statusMessage": "Checking project documentation gaps"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-command-safety.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/validate-command-safety.sh')\"",
            "timeout": 10,
            "statusMessage": "Checking shell command safety"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-commit.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/validate-commit.sh')\"",
            "timeout": 15,
            "statusMessage": "Checking command and commit policy"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-push.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/validate-push.sh')\"",
            "timeout": 10,
            "statusMessage": "Checking push policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-assets.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/validate-assets.sh')\"",
            "timeout": 10,
            "statusMessage": "Validating changed assets"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/validate-skill-change.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/validate-skill-change.sh')\"",
            "timeout": 10,
            "statusMessage": "Checking changed skills"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-compact.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/pre-compact.sh')\"",
            "timeout": 10,
            "statusMessage": "Saving repository session context"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/post-compact.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/post-compact.sh')\"",
            "timeout": 10,
            "statusMessage": "Restoring repository session context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/log-agent.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/log-agent.sh')\"",
            "timeout": 5,
            "statusMessage": "Recording subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/log-agent-stop.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/log-agent-stop.sh')\"",
            "timeout": 5,
            "statusMessage": "Recording subagent completion"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-stop.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$r = git rev-parse --show-toplevel; $g = (Get-Command git.exe).Source; $b = Join-Path (Split-Path (Split-Path $g -Parent) -Parent) 'bin\\bash.exe'; & $b (Join-Path $r '.codex/hooks/session-stop.sh')\"",
            "timeout": 10,
            "statusMessage": "Recording session summary"
          }
        ]
      }
    ]
  }
}
