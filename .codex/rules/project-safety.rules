# Project-local execpolicy rules. These apply when commands request execution
# outside the sandbox. In-sandbox filesystem access is constrained separately
# by the `project-edit` permission profile in ../config.toml.

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only repository status inspection",
    match = ["git status", "git status --short --branch"],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only repository diff inspection",
    match = ["git diff", "git diff --cached --stat"],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only repository history inspection",
    match = ["git log -5 --oneline"],
)

prefix_rule(
    pattern = ["git", "branch", ["--show-current", "--list"]],
    decision = "allow",
    justification = "Read-only branch inspection; mutating branch forms are not allowlisted",
    match = ["git branch --show-current", "git branch --list", "git branch --list feature/example"],
    not_match = ["git branch -D feature/example", "git branch new-name"],
)

prefix_rule(
    pattern = ["git", "rev-parse"],
    decision = "allow",
    justification = "Read-only repository path and revision inspection",
    match = ["git rev-parse --show-toplevel", "git rev-parse HEAD"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes is an external side effect and requires review",
    match = ["git push", "git push origin feature/example"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force-push variants can rewrite shared history; push a new branch or use a reviewed non-force push",
    match = ["git push --force", "git push -f", "git push --force-with-lease"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset can destroy uncommitted work; inspect the diff and use a scoped reversible edit",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-fx", "-fdx"]],
    decision = "forbidden",
    justification = "Forced git clean deletes untracked work; list candidates and remove only explicitly approved paths",
    match = ["git clean -f", "git clean -fd", "git clean -fdx"],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "Recursive forced deletion is unsafe; use an explicit validated target and a recoverable operation",
    match = ["rm -rf build", "rm -fr out"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Project tasks must not elevate through sudo; request a narrowly scoped approval through Codex instead",
    match = ["sudo apt update", "sudo rm file"],
)

prefix_rule(
    pattern = [["python", "python3", "py"], "-m", "pytest"],
    decision = "prompt",
    justification = "Tests execute repository code and may create artifacts or access external resources",
    match = ["python -m pytest", "python3 -m pytest tests/unit", "py -m pytest"],
)
